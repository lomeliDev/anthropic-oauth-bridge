# Anthropic Bridge — example configuration
# Copy to .env and fill in your values. server.py loads .env by itself (no `export` needed).

# ── Server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=64173

# ── Debug ──────────────────────────────────────────────────────
# 1 = full tracebacks + log of every upstream request body (truncated). Keep 0 in production.
BRIDGE_DEBUG=0

# ── Upstream credential (single-account mode) ──────────────────
# Anthropic Console API key (https://console.anthropic.com). Pay-as-you-go.
# NOT a Claude Pro/Max subscription token: subscription OAuth is prohibited in third-party tools.
ANTHROPIC_API_KEY=
# Or route through AWS Bedrock instead (uses your AWS credentials / profile):
# BRIDGE_BACKEND=bedrock
# AWS_REGION=mx-central-1
# AWS_PROFILE=

# ── Client authentication ──────────────────────────────────────
# Clients send: Authorization: Bearer <key>. Empty = any client can use the bridge (only on 127.0.0.1!).
BRIDGE_API_KEY=

# ── Admin protection ──────────────────────────────────────────
# Protects /admin/*. Empty = open (the server warns at startup).
BRIDGE_ADMIN_KEY=

# ── Multi-account ─────────────────────────────────────────────
# BRIDGE_ACCOUNTS_FILE=./accounts.json     (see accounts.example.json)

# ── Behaviour ─────────────────────────────────────────────────
# BRIDGE_DEFAULT_MAX_TOKENS=8192
# BRIDGE_UPSTREAM_TIMEOUT=600
# BRIDGE_CONTEXT_1M=0              # 1 = request the 1M context beta on Sonnet/Opus 4.x
# BRIDGE_QUOTA_TTL=30              # seconds before /v1/quota re-probes rate-limit headers
# BRIDGE_QUOTA_PROBE_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01

# ── Security ──────────────────────────────────────────────────
# BRIDGE_ALLOW_PRIVATE_URLS=0      # 1 = allow image_url/file_url to private/loopback hosts (SSRF risk)
# BRIDGE_MAX_IMAGE_BYTES=20971520
# BRIDGE_MAX_FILE_BYTES=33554432
