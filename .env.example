# ============================================================
# Anthropic OAuth Bridge — environment variables
# ============================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The installer (./install.sh) generates .env automatically.
# ============================================================

# ----- Listen address & port ---------------------------------
HOST=127.0.0.1
PORT=64173

# ----- Client API key (optional) -----------------------------
# Clients must send: Authorization: Bearer <this-key>
# Leave empty to accept requests from any client (no auth).
BRIDGE_API_KEY=

# ----- Admin API key (optional) ------------------------------
# Protects POST /admin/accounts and GET /admin/health.
# Leave empty to leave the admin API fully open (dev mode).
BRIDGE_ADMIN_KEY=

# ----- Anthropic credential file paths -----------------------
# Where OpenCode syncs the OAuth token.
ANTHROPIC_AUTH_PATH=~/.local/share/opencode/auth.json

# Where the Claude Code CLI stores its OAuth token.
CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json

# ----- OAuth client id ---------------------------------------
# This is the public Claude Code client id.
ANTHROPIC_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# ----- Multi-account config ----------------------------------
# Path to the accounts.json file (generated by admin API).
# Default: bridge root directory.
BRIDGE_ACCOUNTS_FILE=./accounts.json

# Directory for per-account access token caches.
# Default: ./auth_cache/
BRIDGE_AUTH_CACHE_DIR=./auth_cache

# ----- Claude Code version (for billing header) --------------
ANTHROPIC_CLI_VERSION=2.1.112
CLAUDE_CODE_ENTRYPOINT=sdk-cli

# ----- Debug logging (optional) ------------------------------
# Set to "1" to log to ./claude-auth-debug.log
# Set to a custom path to log to that file.
CLAUDE_AUTH_DEBUG=
CLAUDE_AUTH_DEBUG_DIR=.
